/*
  # ── Anti-clickjacking: impide que el sitio se embeba en un iframe ajeno ──
  X-Frame-Options: SAMEORIGIN

  # ── Evita que el navegador adivine el tipo de contenido ──
  X-Content-Type-Options: nosniff

  # ── No filtrar la URL completa al navegar a dominios externos ──
  Referrer-Policy: strict-origin-when-cross-origin

  # ── Desactiva APIs del navegador que el sitio no utiliza ──
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()

  # ── Aísla el contexto de navegación ──
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # ── CSP en modo REPORT-ONLY ──
  # Se despliega primero sin bloquear para inventariar violaciones reales.
  # Al confirmar que no hay falsos positivos, renombrar la cabecera a
  # Content-Security-Policy para que pase a aplicarse.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://services.leadconnectorhq.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://res.cloudinary.com https://images.leadconnectorhq.com; media-src 'self' https://res.cloudinary.com; connect-src 'self' https://services.leadconnectorhq.com https://api-desarrollo.powerhousebiotech.com; frame-src 'self' https://link.leadconnectorhq.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://services.leadconnectorhq.com; object-src 'none'; upgrade-insecure-requests

# ── Assets con hash de contenido: caché inmutable de un año ──
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Archivos de indexación: caché corta para poder actualizarlos rápido ──
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
